<Application xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:DaylightCommander.App.Icons"
             xmlns:local="using:DaylightCommander.App"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaylightCommander.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- UI 글꼴: SeoulNamsan 400/700/800 (fonts.md). 폴백은 OS 글꼴. -->
        <FontFamily x:Key="AppFont">avares://DaylightCommander/Assets/Fonts#SeoulNamsan</FontFamily>

        <!-- 아이콘 (Material Icons, 24x24): 원본 Flutter의 폴더·파일 아이콘과 같은 모양 -->
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- 내장 에디터(AvaloniaEdit) 기본 스타일 -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- 원본 Flutter 앱의 글자 크기: 본문 13 (ui-ux.md §4). -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="avares://DaylightCommander/Assets/app_icon.ico" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>

        <!-- 목록 행: 가로 12 세로 4, 커서(선택) 행은 주색 30% (활성 패널), 마우스 올림은 옅게 -->
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>

        <!-- 격자 보기: 행(ListBoxItem)은 아무 모양도 없고, 타일(Border.tile)이 커서·선택·올림을 그린다 -->
        <Style Selector="ListBox.tiles ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.tiles ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Border.tile.cursor">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>
        <Style Selector="Border.tile.drop">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
        </Style>

        <!-- 폴더 비교: 행 배경 -->
        <Style Selector="Border.diffrow.onlyhere">
            <Setter Property="Background" Value="{DynamicResource AppDiffOnly}" />
        </Style>
        <Style Selector="Border.diffrow.differs">
            <Setter Property="Background" Value="{DynamicResource AppDiffDiffers}" />
        </Style>

        <!-- 선택된(표시한) 행·타일: 한 개든 여러 개든 행 전체가 주색 30% (비교 색보다 우선) -->
        <Style Selector="Border.diffrow.picked">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>

        <!-- 에디터 메뉴 막대와 그 팝업 -->
        <Style Selector="MenuItem">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
        </Style>

        <!-- 디렉터리 트리 -->
        <Style Selector="Border.treerow">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.treerow:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Border.treerow.drop">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.treerow.sel">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>
        <Style Selector="Button.treetoggle">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>

        <!-- 끌어다 놓을 폴더 행 -->
        <Style Selector="ListBox.entries ListBoxItem.drop /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 작은 글자 (11): 코드가 만드는 TextBlock에 Classes="small"로 붙인다 -->
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
        </Style>

        <!-- 행 내용: 가로 12 세로 4 여백 (ListBoxItem 안쪽이 아니라 내용에 두어야 선택 배경이 행 전체를 덮는다) -->
        <Style Selector="ListBox.entries ListBoxItem > Border > Grid">
            <Setter Property="Margin" Value="12,4" />
        </Style>

        <!-- 툴바 아이콘 버튼 30x30, 아이콘 18 -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>
        <!-- 아이콘 버튼: 배경은 늘 투명. 마우스를 올리면 옅게 깔리고, 쓸 수 없으면 아이콘이 훨씬 희미하다 -->
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="Button.tool icons|DuoIcon, ToggleButton.tool icons|DuoIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>

        <!-- 컬럼 헤더: 글자만 보이는 납작한 버튼 (11, 굵게) -->
        <Style Selector="Button.header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>

        <!-- 패널 카드: 둥근 12, 테두리 2px. 활성 패널은 주색 -->
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
        </Style>


        <!-- 일반 버튼은 알약 모양 (원본 Flutter). 아이콘 버튼(tool)·열 머리글(header)은 아래에서 따로 정한다 -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <!-- 즐겨찾기·최근 방문 메뉴 -->
        <Style Selector="Border.menu">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHi}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="TextElement.FontSize" Value="{DynamicResource FsBody}" />
        </Style>
        <Style Selector="Button.menuitem">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.menuitem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- 설정 창 -->
        <Style Selector="ToggleButton.nav">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>
        <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>
        <!-- 분절 버튼: 바깥 틀이 알약 모양, 안의 칸은 각져도 틀에 잘려 둥글게 보인다 -->
        <Style Selector="Border.segframe">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ToggleButton.seg">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnPrimary}" />
        </Style>
        <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnPrimary}" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="Button.picker">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.pathbox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- 창 크롬 정책 A(인-윈도 모달): 타이틀바 없는 창에 앱이 둥근 테두리를 그린다. 원문은 CLAUDE.md의 "창 크롬·단추 정책" 참고 -->
        <Style Selector="Window.dialog">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{DynamicResource AppSurfaceHi}" BorderBrush="{DynamicResource AppStrokeStrong}"
                            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <VisualLayerManager>
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </VisualLayerManager>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 단추 정책 §5 (단추 스타일은 여기 한 곳에서만 정한다):
             주 동작 = Button.accent(채운 알약, 맨 오른쪽), 보조 동작 = 대화상자 안의 그 밖의 단추(배경 없는 강조색 글자).
             Button.text는 대화상자 밖(예: 창 본문)에서 같은 글자 단추가 필요할 때 붙인다. -->
        <Style Selector="Window.dialog Button:not(.accent):not(.tool):not(.cmd), Button.text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Window.dialog Button:not(.accent):not(.tool):not(.cmd):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>
        <Style Selector="Window.dialog Button:not(.accent):not(.tool):not(.cmd):disabled /template/ ContentPresenter#PART_ContentPresenter, Button.text:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 명령 모음 버튼 (Windows 11 탐색기 방식): 납작한 투명 버튼, 높이 30, 아이콘은 주색. 마우스를 올리면 옅게 깔린다 -->
        <Style Selector="Button.cmd">
            <Setter Property="local:UiScale.Enabled" Value="True" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="{DynamicResource FsMid}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        </Style>
        <Style Selector="Button.cmd.icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cmd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="Button.cmd:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- 아이콘이 글자 줄보다 크면 글자가 칸 위쪽에 붙으므로 둘 다 세로 가운데로 맞춘다 -->
        <Style Selector="Button.cmd TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cmd icons|DuoIcon">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>
        <Style Selector="Button.cmd icons|DuoIcon.caret">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>
        <Style Selector="Border.cmdsep">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AppStroke}" />
        </Style>

        <!-- 진행 중인 작업 목록: 창 맨 아래에 뜬다 (작업이 있을 때만) -->
        <Style Selector="Border.opspanel">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppNoticeBorder}" />
            <Setter Property="Background" Value="{DynamicResource AppNoticeBg}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- 영구 삭제 확인 버튼: 위험색 -->
        <Style Selector="Button.accent.danger">
            <Setter Property="Background" Value="{DynamicResource AppDanger}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDanger}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 작업 목록의 실패 상태 -->
        <Style Selector="TextBlock.failed">
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>

        <!-- 상태 표시줄의 오류: 위험색 -->
        <Style Selector="Border.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>
    </Application.Styles>
</Application>
