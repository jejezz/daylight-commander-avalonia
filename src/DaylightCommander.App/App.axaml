<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DaylightCommander.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <!-- UI 글꼴: SeoulNamsan 400/700/800 (fonts.md). 폴백은 OS 글꼴. -->
        <FontFamily x:Key="AppFont">avares://DaylightCommander/Assets/Fonts#SeoulNamsan</FontFamily>

        <!-- 아이콘 (Material Icons, 24x24): 원본 Flutter의 폴더·파일 아이콘과 같은 모양 -->
        <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
        <StreamGeometry x:Key="IconFile">M6 2c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6H6zm7 7V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
        <StreamGeometry x:Key="IconSettings">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconPalette">M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 9 6.5 9 8 9.67 8 10.5 7.33 12 6.5 12zm3-4C8.67 8 8 7.33 8 6.5S8.67 5 9.5 5s1.5.67 1.5 1.5S10.33 8 9.5 8zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 5 14.5 5s1.5.67 1.5 1.5S15.33 8 14.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 9 17.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</StreamGeometry>
        <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowDown">M7 10l5 5 5-5z</StreamGeometry>
        <StreamGeometry x:Key="IconHeart">M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z</StreamGeometry>
        <StreamGeometry x:Key="IconHeartOutline">M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z</StreamGeometry>
        <StreamGeometry x:Key="IconHistory">M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
        <StreamGeometry x:Key="IconDrive">M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconMemory">M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z</StreamGeometry>
        <StreamGeometry x:Key="IconDescription">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z</StreamGeometry>
        <StreamGeometry x:Key="IconRedo">M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</StreamGeometry>
        <StreamGeometry x:Key="IconFindReplace">M11 6c1.38 0 2.63.56 3.54 1.46L12 10h6V4l-2.05 2.05C14.68 4.78 12.93 4 11 4c-3.53 0-6.43 2.61-6.92 6H6.1c.46-2.28 2.48-4 4.9-4zm5.64 9.14c.66-.9 1.12-1.97 1.28-3.14H15.9c-.46 2.28-2.48 4-4.9 4-1.38 0-2.63-.56-3.54-1.46L10 12H4v6l2.05-2.05C7.32 17.22 9.07 18 11 18c1.55 0 2.98-.51 4.14-1.36L20.49 21.49 22 20l-4.85-4.86z</StreamGeometry>
        <StreamGeometry x:Key="IconWrap">M4 19h6v-2H4v2zM20 5H4v2h16V5zm-3 6H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2c2.21 0 4-1.79 4-4s-1.79-4-4-4z</StreamGeometry>
        <StreamGeometry x:Key="IconSave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>
        <StreamGeometry x:Key="IconSaveAs">M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z</StreamGeometry>
        <StreamGeometry x:Key="IconArrowUp">M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>
        <StreamGeometry x:Key="IconGoToLine">M5 9h14V7H5v2zm0 4h14v-2H5v2zm0 4h8v-2H5v2z</StreamGeometry>
        <StreamGeometry x:Key="IconInfo">M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z</StreamGeometry>
        <StreamGeometry x:Key="IconBack">M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z</StreamGeometry>
        <StreamGeometry x:Key="IconForward">M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z</StreamGeometry>
        <StreamGeometry x:Key="IconUp">M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z</StreamGeometry>
        <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
        <StreamGeometry x:Key="IconVisible">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
        <StreamGeometry x:Key="IconVisibleOff">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- 내장 에디터(AvaloniaEdit) 기본 스타일 -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- 원본 Flutter 앱의 글자 크기: 본문 13 (ui-ux.md §4). -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="avares://DaylightCommander/Assets/app_icon.ico" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
            <Setter Property="Background" Value="{DynamicResource AppBg}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>

        <!-- 목록 행: 가로 12 세로 4, 커서(선택) 행은 주색 30% (활성 패널), 마우스 올림은 옅게 -->
        <Style Selector="ListBox.entries ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>
        <Style Selector="ListBox.entries ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
        </Style>

        <!-- 끌어다 놓을 폴더 행 -->
        <Style Selector="ListBox.entries ListBoxItem.drop /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 작은 글자 (11): 코드가 만드는 TextBlock에 Classes="small"로 붙인다 -->
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
        </Style>

        <!-- 행 내용: 가로 12 세로 4 여백 (ListBoxItem 안쪽이 아니라 내용에 두어야 선택 배경이 행 전체를 덮는다) -->
        <Style Selector="ListBox.entries ListBoxItem > Grid">
            <Setter Property="Margin" Value="12,4" />
        </Style>
        <!-- 선택된 행(커서와 별개): 글자가 주색 -->
        <Style Selector="ListBox.entries ListBoxItem > Grid.picked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>

        <!-- 툴바 아이콘 버튼 30x30, 아이콘 18 -->
        <Style Selector="Button.tool, ToggleButton.tool">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>
        <!-- 아이콘 버튼: 배경은 늘 투명. 마우스를 올리면 옅게 깔리고, 쓸 수 없으면 아이콘이 훨씬 희미하다 -->
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.25" />
        </Style>
        <Style Selector="Button.tool PathIcon, ToggleButton.tool PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>

        <!-- 컬럼 헤더: 글자만 보이는 납작한 버튼 (11, 굵게) -->
        <Style Selector="Button.header">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="{DynamicResource FsSmall}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.header:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>

        <!-- 패널 카드: 둥근 12, 테두리 2px. 활성 패널은 주색 -->
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
            <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
        </Style>


        <!-- 일반 버튼은 알약 모양 (원본 Flutter). 아이콘 버튼(tool)·열 머리글(header)은 아래에서 따로 정한다 -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <!-- 즐겨찾기·최근 방문 메뉴 -->
        <Style Selector="Border.menu">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHi}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="BoxShadow" Value="0 4 16 0 #40000000" />
        </Style>
        <Style Selector="Button.menuitem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppHover}" />
        </Style>
        <Style Selector="Button.menuitem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- 설정 창 -->
        <Style Selector="ToggleButton.nav">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextMid}" />
        </Style>
        <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>
        <!-- 분절 버튼: 바깥 틀이 알약 모양, 안의 칸은 각져도 틀에 잘려 둥글게 보인다 -->
        <Style Selector="Border.segframe">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ToggleButton.seg">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnPrimary}" />
        </Style>
        <Style Selector="ToggleButton.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnPrimary}" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimary}" />
            <Setter Property="Background" Value="{DynamicResource AppCursor}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextHi}" />
        </Style>
        <Style Selector="Button.picker">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.pathbox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStroke}" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- 짧은 질문 창: 패널보다 한 단계 띄운 색 (원본 결정) -->
        <Style Selector="Window.dialog">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceHi}" />
        </Style>

        <!-- 하단 기능 키 버튼: 둥근 18, 높이 36, 글자 12 -->
        <Style Selector="Button.fkey">
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="{DynamicResource FsMid}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStrokeStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource AppPrimary}" />
        </Style>

        <!-- 진행 중인 작업 목록: 기능 키 바 위에 겹쳐 뜬다 -->
        <Style Selector="Border.opspanel">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppNoticeBorder}" />
            <Setter Property="Background" Value="{DynamicResource AppNoticeBg}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- 영구 삭제 확인 버튼: 위험색 -->
        <Style Selector="Button.accent.danger">
            <Setter Property="Background" Value="{DynamicResource AppDanger}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDanger}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 작업 목록의 실패 상태 -->
        <Style Selector="TextBlock.failed">
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>

        <!-- 상태 표시줄의 오류: 위험색 -->
        <Style Selector="Border.error TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppDanger}" />
        </Style>
    </Application.Styles>
</Application>
