<dlg:DialogBase xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:dlg="using:DaylightCommander.App.Dialogs"
                x:Class="DaylightCommander.App.Dialogs.TextPromptDialog"
                MinWidth="440">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FsTitle}" FontWeight="Bold"/>
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" IsVisible="False"/>
        <TextBox x:Name="Input"/>
        <TextBlock x:Name="ErrorText" FontSize="{DynamicResource FsSmall}" TextWrapping="Wrap" IsVisible="False"
                   Foreground="{DynamicResource AppDanger}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button x:Name="CancelButton"/>
            <Button x:Name="OkButton" Classes="accent"/>
        </StackPanel>
    </StackPanel>
</dlg:DialogBase>
