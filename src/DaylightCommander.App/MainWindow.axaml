<Window xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:DaylightCommander.App.Icons"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DaylightCommander.App.Views"
        xmlns:vm="using:DaylightCommander.App.ViewModels"
        x:DataType="vm:HomeViewModel"
        x:Class="DaylightCommander.App.MainWindow"
        Title="Daylight Commander"
        Width="1200" Height="720" MinWidth="960" MinHeight="600">
    <Grid RowDefinitions="44,Auto,*,Auto,Auto">
        <!-- 앱 바 44 (ui-ux.md §3) -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppStroke}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Daylight Commander" VerticalAlignment="Center"
                           FontWeight="ExtraBold" FontSize="{DynamicResource FsTitle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="NewWindow" Classes="header" Content="{DynamicResource Str.AppBarNewWindow}"/>
                    <ToggleButton x:Name="TreeButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.TreeTooltip}">
                        <icons:DuoIcon Icon="tree"/>
                    </ToggleButton>
                    <Button Classes="tool" Command="{Binding OpenTerminalCommand}" ToolTip.Tip="{DynamicResource Str.TerminalTooltip}">
                        <icons:DuoIcon Icon="terminal"/>
                    </Button>
                    <ToggleButton Classes="tool" IsChecked="{Binding CompareMode, Mode=TwoWay}" ToolTip.Tip="{DynamicResource Str.CompareOnTooltip}">
                        <icons:DuoIcon Icon="compare"/>
                    </ToggleButton>
                    <Button Classes="tool" Command="{Binding SwapPanesCommand}" ToolTip.Tip="{DynamicResource Str.SwapPanesTooltip}">
                        <icons:DuoIcon Icon="swap"/>
                    </Button>
                    <Button Classes="tool" Command="{Binding TogglePaneModeCommand}" ToolTip.Tip="{Binding PaneModeTooltip}">
                        <icons:DuoIcon Icon="{Binding PaneModeIcon}"/>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.SettingsTooltip}">
                        <icons:DuoIcon Icon="settings"/>
                    </Button>
                    <Button x:Name="AboutButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.AboutTooltip}">
                        <icons:DuoIcon Icon="info"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 명령 모음 (앱 바 아래, Windows 11 탐색기 방식) -->
        <views:CommandBar Grid.Row="1"/>

        <!-- 왼쪽 디렉터리 트리(접을 수 있고 폭 조절) + 좌우 두 패널. 카드는 둥근 모서리 12, 활성 패널은 주색 2px 테두리 -->
        <Grid Grid.Row="2" x:Name="Body" ColumnDefinitions="0,0,*" Margin="8">
            <Border Grid.Column="0" Classes="card" x:Name="TreeCard" IsVisible="False">
                <views:DirectoryTreeView DataContext="{Binding Tree}"/>
            </Border>
            <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="8" Background="Transparent" IsVisible="False"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"/>
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ColAWidth}"/>
                    <ColumnDefinition Width="{Binding GapWidth}"/>
                    <ColumnDefinition Width="{Binding ColBWidth}"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="{Binding LeftColumn}" Classes="card" Classes.active="{Binding Left.IsActive}"
                        IsVisible="{Binding LeftExpanded}">
                    <views:PaneView DataContext="{Binding Left}"/>
                </Border>
                <Border Grid.Column="{Binding RightColumn}" Classes="card" Classes.active="{Binding Right.IsActive}"
                        IsVisible="{Binding RightExpanded}">
                    <views:PaneView DataContext="{Binding Right}"/>
                </Border>
                <!-- 1패널 모드에서 접힌 패널: 가장자리의 좁은 막대 (누르면 펼침, 파일을 놓으면 복사/이동) -->
                <Border Grid.Column="{Binding LeftColumn}" IsVisible="{Binding LeftIsRail}">
                    <views:PaneRail DataContext="{Binding Left}"/>
                </Border>
                <Border Grid.Column="{Binding RightColumn}" IsVisible="{Binding RightIsRail}">
                    <views:PaneRail DataContext="{Binding Right}"/>
                </Border>
                <!-- 두 패널 사이: 한쪽 패널의 경로를 다른 쪽으로 보낸다 (Ctrl+Shift+→ / ←). 1패널 모드에서는 숨긴다 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding DualPane}">
                    <Button Classes="tool" Width="24" Height="24" Command="{Binding SyncPathRightCommand}"
                            ToolTip.Tip="{DynamicResource Str.SyncPathRightTooltip}">
                        <icons:DuoIcon Icon="forward" Width="16" Height="16"/>
                    </Button>
                    <Button Classes="tool" Width="24" Height="24" Command="{Binding SyncPathLeftCommand}"
                            ToolTip.Tip="{DynamicResource Str.SyncPathLeftTooltip}">
                        <icons:DuoIcon Icon="back" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 폴더 비교 중이면 보이는 동기화 막대: 차이 복사(→, ←)와 양방향 동기화 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="8,0,8,8" IsVisible="{Binding CompareMode}">
            <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SyncToRightCommand}" IsEnabled="{Binding CanSyncRight}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:DuoIcon Icon="sync" Width="16" Height="16" ColorKey="AppPrimary"/>
                    <TextBlock Text="{Binding SyncRightText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SyncToLeftCommand}" IsEnabled="{Binding CanSyncLeft}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:DuoIcon Icon="sync" Width="16" Height="16" ColorKey="AppPrimary"/>
                    <TextBlock Text="{Binding SyncLeftText}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding SyncBothCommand}" IsEnabled="{Binding CanSyncBoth}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <icons:DuoIcon Icon="sync" Width="16" Height="16" ColorKey="AppPrimary"/>
                    <TextBlock Text="{DynamicResource Str.SyncBidirectional}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 진행 중인 파일 작업 목록: 작업이 있을 때만 맨 아래에 뜬다. 많으면 안에서 스크롤 -->
        <views:OperationsPanel Grid.Row="4" x:Name="Operations" DataContext="{Binding Operations}"
                               Margin="8,0,8,8" MaxHeight="160"/>
    </Grid>
</Window>
