<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DaylightCommander.App.Views"
        xmlns:vm="using:DaylightCommander.App.ViewModels"
        x:DataType="vm:HomeViewModel"
        x:Class="DaylightCommander.App.MainWindow"
        Title="Daylight Commander"
        Width="1200" Height="720" MinWidth="960" MinHeight="600">
    <Grid RowDefinitions="44,*,Auto">
        <!-- 앱 바 44 (ui-ux.md §3) -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppStroke}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Daylight Commander" VerticalAlignment="Center"
                           FontWeight="ExtraBold" FontSize="{DynamicResource FsTitle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="NewWindow" Classes="header" Content="{DynamicResource Str.AppBarNewWindow}"/>
                    <Button x:Name="AboutButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.AboutTooltip}">
                        <PathIcon Data="{StaticResource IconInfo}"/>
                    </Button>
                    <Button x:Name="SettingsButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.SettingsTooltip}">
                        <PathIcon Data="{StaticResource IconSettings}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 좌우 두 패널. 카드는 둥근 모서리 12, 활성 패널은 주색 2px 테두리 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="8" ColumnSpacing="8">
            <Border Grid.Column="0" Classes="card" Classes.active="{Binding Left.IsActive}">
                <views:PaneView DataContext="{Binding Left}"/>
            </Border>
            <Border Grid.Column="1" Classes="card" Classes.active="{Binding Right.IsActive}">
                <views:PaneView DataContext="{Binding Right}"/>
            </Border>
        </Grid>

        <!-- 하단 기능 키 바. 파일 작업이 있으면 같은 자리를 작업 목록이 덮는다 (바 높이를 넘지 않는다) -->
        <Grid Grid.Row="2" Margin="8,0,8,8">
            <views:FunctionKeyBar x:Name="Bar"/>
            <views:OperationsPanel x:Name="Operations" DataContext="{Binding Operations}"
                                   VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
