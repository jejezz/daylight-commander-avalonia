<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:DaylightCommander.App.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaylightCommander.App.ViewModels"
             xmlns:views="using:DaylightCommander.App.Views"
             x:Class="DaylightCommander.App.Views.DirectoryTreeView"
             x:DataType="vm:DirectoryTreeViewModel">
    <!-- 탐색기 모양 트리: 행 26, 들여쓰기 14, 선택(현재 경로)은 커서 색. 오른쪽 위 새로고침, 행 우클릭 메뉴, 폴더 끌어다 놓기 -->
    <Grid x:Name="Host" Background="Transparent">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeRow">
                        <Border Classes="treerow" Classes.sel="{Binding Selected}" Height="26"
                                Tag="{Binding}" Padding="{Binding Indent}">
                            <Grid ColumnDefinitions="20,Auto,*">
                                <Button Grid.Column="0" Classes="treetoggle" IsVisible="{Binding CanExpand}" Tag="{Binding}">
                                    <Grid>
                                        <icons:DuoIcon Width="14" Height="14" Icon="caret-right" ColorKey="AppTextMid" IsVisible="{Binding ShowCollapsed}"/>
                                        <icons:DuoIcon Width="14" Height="14" Icon="caret-down" ColorKey="AppTextMid" IsVisible="{Binding ShowExpanded}"/>
                                    </Grid>
                                </Button>
                                <icons:DuoIcon Grid.Column="1" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Icon="{Binding IconName}" ColorKey="{Binding IconColor}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"
                                           FontWeight="{Binding Selected, Converter={x:Static views:TreeFonts.Weight}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="ReloadButton" Classes="tool" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,2,10,0" ToolTip.Tip="{DynamicResource Str.PaneRefreshTooltip}">
            <icons:DuoIcon Icon="refresh" Width="14" Height="14"/>
        </Button>

        <!-- 행 우클릭 메뉴 (내용은 우클릭할 때 코드가 채운다) -->
        <Popup x:Name="ContextPopup" PlacementTarget="{Binding #Host}" Placement="Pointer" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True">
            <Border Classes="menu"><StackPanel x:Name="ContextItems" MinWidth="200"/></Border>
        </Popup>
    </Grid>
</UserControl>
