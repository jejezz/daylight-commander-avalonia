<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaylightCommander.App.ViewModels"
             xmlns:app="using:DaylightCommander.App"
             x:Class="DaylightCommander.App.Views.FunctionKeyBar"
             x:DataType="vm:HomeViewModel">
    <!-- 하단 버튼 두 줄 (원본의 F-키 바). 아직 없는 기능(압축·패턴선택)은 자리만 두고 꺼 둔다. 윗줄은 F2부터 F8까지 번호 순서. -->
    <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="fkey" Content="{DynamicResource Str.FnRename}"
                    Command="{Binding RenameCommand}" IsEnabled="{Binding HasTarget}"/>
            <Button Grid.Column="1" Classes="fkey" Content="{DynamicResource Str.FnView}"
                    Command="{Binding ViewCommand}" IsEnabled="{Binding CanView}"/>
            <Button Grid.Column="2" Classes="fkey" Content="{DynamicResource Str.FnEdit}"
                    Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}"/>
            <Button Grid.Column="3" Classes="fkey" Content="{DynamicResource Str.FnCopy}"
                    Command="{Binding CopyCommand}" IsEnabled="{Binding HasTarget}"/>
            <Button Grid.Column="4" Classes="fkey" Content="{DynamicResource Str.FnMove}"
                    Command="{Binding MoveCommand}" IsEnabled="{Binding HasTarget}"/>
            <Button Grid.Column="5" Classes="fkey" Content="{DynamicResource Str.FnNewFolder}"
                    Command="{Binding NewFolderCommand}"/>
            <Button Grid.Column="6" Classes="fkey" Content="{DynamicResource Str.FnDelete}"
                    Command="{Binding DeleteCommand}" IsEnabled="{Binding HasTarget}"/>
        </Grid>
        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Classes="fkey" Content="{DynamicResource Str.FnNewFile}"
                    Command="{Binding NewFileCommand}"/>
            <Button Grid.Column="1" Classes="fkey" Content="{DynamicResource Str.FnCompress}"
                    Command="{Binding CompressCommand}" IsEnabled="{Binding HasTarget}"/>
            <Button Grid.Column="2" Classes="fkey" Content="{DynamicResource Str.FnExtract}"
                    Command="{Binding ExtractCommand}"/>
            <Button Grid.Column="3" Classes="fkey" Content="{DynamicResource Str.FnProperties}"
                    Command="{Binding PropertiesCommand}" IsEnabled="{Binding HasTarget}"/>
            <Button Grid.Column="4" Classes="fkey" Content="{DynamicResource Str.FnPatternSelect}" IsEnabled="False"/>
        </Grid>
    </StackPanel>
</UserControl>
