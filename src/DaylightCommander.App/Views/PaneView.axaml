<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:icons="using:DaylightCommander.App.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaylightCommander.App.ViewModels"
             xmlns:app="using:DaylightCommander.App"
             x:Class="DaylightCommander.App.Views.PaneView"
             x:DataType="vm:PaneViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 툴바: 뒤로 · 앞으로 · 상위 · 새로고침 | 경로 | 숨김 파일 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="6,4" ColumnSpacing="2">
            <Button Grid.Column="0" Classes="tool" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                    ToolTip.Tip="{DynamicResource Str.PaneBackTooltip}">
                <icons:DuoIcon Icon="back"/>
            </Button>
            <Button Grid.Column="1" Classes="tool" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanGoForward}"
                    ToolTip.Tip="{DynamicResource Str.PaneForwardTooltip}">
                <icons:DuoIcon Icon="forward"/>
            </Button>
            <Button Grid.Column="2" Classes="tool" Command="{Binding UpCommand}" IsEnabled="{Binding CanGoUp}"
                    ToolTip.Tip="{DynamicResource Str.PaneUpTooltip}">
                <icons:DuoIcon Icon="up"/>
            </Button>
            <Button Grid.Column="3" Classes="tool" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="{DynamicResource Str.PaneRefreshTooltip}">
                <icons:DuoIcon Icon="refresh"/>
            </Button>

            <!-- 즐겨찾기(하트)와 최근 방문(시계) 메뉴. 메뉴 내용은 열 때 코드가 채운다 -->
            <Button Grid.Column="4" x:Name="BookmarkButton" Classes="tool"
                    ToolTip.Tip="{DynamicResource Str.BookmarkTooltip}">
                <Grid>
                    <icons:DuoIcon Icon="heart" IsVisible="{Binding IsBookmarked}"
                              Foreground="{DynamicResource AppDanger}"/>
                    <icons:DuoIcon Icon="heart-outline" IsVisible="{Binding !IsBookmarked}"/>
                </Grid>
            </Button>
            <Button Grid.Column="5" x:Name="RecentButton" Classes="tool"
                    ToolTip.Tip="{DynamicResource Str.RecentTooltip}">
                <icons:DuoIcon Icon="history"/>
            </Button>

            <!-- 드라이브 전환: 누르면 이 컴퓨터의 드라이브(볼륨) 목록이 뜬다 -->
            <Button Grid.Column="6" x:Name="DriveButton" Classes="tool"
                    ToolTip.Tip="{DynamicResource Str.DriveTooltip}">
                <icons:DuoIcon Icon="drive"/>
            </Button>

            <!-- 경로 표시줄: 직접 고쳐 쓰고 Enter로 이동, Esc로 되돌린다 -->
            <!-- 네트워크 드라이브: 서버 연결·저장한 서버·연결 해제 -->
            <Button Grid.Column="7" x:Name="NetworkButton" Classes="tool"
                    ToolTip.Tip="{DynamicResource Str.NetworkTooltip}">
                <icons:DuoIcon Icon="drive-network"/>
            </Button>

            <TextBox Grid.Column="8" x:Name="PathBox" Text="{Binding PathText}" Margin="6,0" FontSize="{DynamicResource FsMid}"
                     MinHeight="0" Padding="8,6" VerticalContentAlignment="Center"
                     Background="Transparent" BorderBrush="{DynamicResource AppStroke}" CornerRadius="6"/>

            <!-- 보기 방식: 목록 · 작은 미리보기 · 큰 미리보기 -->
            <Button Grid.Column="9" x:Name="ViewButton" Classes="tool"
                    ToolTip.Tip="{DynamicResource Str.PaneViewTooltip}">
                <Grid>
                    <icons:DuoIcon Icon="view-list" IsVisible="{Binding IsList}"/>
                    <icons:DuoIcon Icon="view-grid" IsVisible="{Binding IsGrid}"/>
                </Grid>
            </Button>

            <ToggleButton Grid.Column="10" Classes="tool" IsChecked="{Binding ShowHidden, Mode=OneWay}"
                          Command="{Binding ToggleHiddenCommand}"
                          ToolTip.Tip="{DynamicResource Str.PaneShowHiddenTooltip}">
                <Grid>
                    <icons:DuoIcon Icon="visible" IsVisible="{Binding ShowHidden}"/>
                    <icons:DuoIcon Icon="visible-off" IsVisible="{Binding !ShowHidden}"/>
                </Grid>
            </ToggleButton>
        </Grid>

        <!-- 즐겨찾기·최근 방문 메뉴 (Popup: 내용은 버튼을 누를 때 코드가 채운다) -->
        <Popup x:Name="BookmarkPopup" PlacementTarget="{Binding #BookmarkButton}" Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True">
            <Border Classes="menu"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="BookmarkItems"/></ScrollViewer></Border>
        </Popup>
        <Popup x:Name="DrivePopup" PlacementTarget="{Binding #DriveButton}" Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True">
            <Border Classes="menu"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DriveItems"/></ScrollViewer></Border>
        </Popup>
        <Popup x:Name="NetworkPopup" PlacementTarget="{Binding #NetworkButton}" Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True">
            <Border Classes="menu"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NetworkItems"/></ScrollViewer></Border>
        </Popup>
        <Popup x:Name="RecentPopup" PlacementTarget="{Binding #RecentButton}" Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="True">
            <Border Classes="menu"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RecentItems"/></ScrollViewer></Border>
        </Popup>

        <Popup x:Name="ViewPopup" PlacementTarget="{Binding #ViewButton}" Placement="BottomEdgeAlignedRight"
               IsLightDismissEnabled="True">
            <Border Classes="menu"><StackPanel x:Name="ViewItems" MinWidth="160"/></Border>
        </Popup>

        <!-- 행 우클릭 메뉴 (내용은 우클릭할 때 코드가 채운다) -->
        <Popup x:Name="ContextPopup" PlacementTarget="{Binding #Entries}" Placement="Pointer" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True">
            <Border Classes="menu"><StackPanel x:Name="ContextItems" MinWidth="220"/></Border>
        </Popup>

        <!-- 컬럼 헤더: 이름 | 크기(80) | 수정일(130), 간격 12. 눌러서 정렬 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,80,130" Margin="12,0" ColumnSpacing="12" IsVisible="{Binding IsList}">
            <Button Grid.Column="0" Classes="header" Command="{Binding SortCommand}" CommandParameter="Name">
                <TextBlock Text="{Binding NameHeader}"/>
            </Button>
            <Button Grid.Column="1" Classes="header" Command="{Binding SortCommand}" CommandParameter="Size"
                    HorizontalContentAlignment="Right">
                <TextBlock Text="{Binding SizeHeader}" TextAlignment="Right"/>
            </Button>
            <Button Grid.Column="2" Classes="header" Command="{Binding SortCommand}" CommandParameter="Modified">
                <TextBlock Text="{Binding ModifiedHeader}"/>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <!-- 선택(커서)은 컨트롤러가 정한다: 클릭은 코드 비하인드가 컨트롤러로 보내고, 목록은 따라 그리기만 한다 -->
            <ListBox x:Name="Entries" ItemsSource="{Binding Items}" IsVisible="{Binding IsList}" SelectedItem="{Binding Cursor, Mode=OneWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" Classes="entries">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EntryItem">
                        <Border Classes="diffrow" Classes.onlyhere="{Binding IsOnlyHere}" Classes.differs="{Binding IsDiffers}"
                                Classes.picked="{Binding IsSelected}">
                        <Grid ColumnDefinitions="*,80,130" ColumnSpacing="12" Opacity="{Binding RowOpacity}">
                            <!-- 이름 칸: 아이콘(고정) + 이름(남는 폭). StackPanel로 두면 이름이 폭 제한을 못 받아 긴 이름이 크기 칸을 덮는다 -->
                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" ClipToBounds="True">
                                <icons:DuoIcon Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center"
                                               Icon="{Binding IconName}" ColorKey="{Binding IconColor}"/>
                                <!-- 줄어든 이름은 마우스를 올리면 전체 경로가 말풍선으로 보인다 -->
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="{DynamicResource FsSmall}"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="{DynamicResource FsSmall}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 격자 보기: 행 단위로 가상화한다. 한 행은 가로로 놓인 타일들. 타일 클릭·끌기는 코드 비하인드가 목록 보기와 같게 처리한다 -->
            <ListBox x:Name="Tiles" ItemsSource="{Binding Rows}" IsVisible="{Binding IsGrid}"
                     Background="Transparent" BorderThickness="0" Padding="0" Classes="tiles">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TileRow">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EntryItem">
                                    <Border Classes="tile diffrow" Classes.cursor="{Binding IsCursor}" Classes.picked="{Binding IsSelected}"
                                            Classes.onlyhere="{Binding IsOnlyHere}" Classes.differs="{Binding IsDiffers}"
                                            Width="{Binding TileWidth}" Height="{Binding TileHeight}"
                                            Opacity="{Binding RowOpacity}" ToolTip.Tip="{Binding Path}">
                                        <StackPanel Margin="4" Spacing="4">
                                            <Grid Width="{Binding IconSize}" Height="{Binding IconSize}" HorizontalAlignment="Center">
                                                <icons:TileIcon Icon="{Binding IconName}" ColorKey="{Binding IconColor}"
                                                                Badge="{Binding BadgeText}" IsVisible="{Binding NoThumbnail}"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                       IsVisible="{Binding HasThumbnail}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center" FontSize="{DynamicResource FsSmall}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 끌어다 놓을 때 이 패널 폴더가 목적지이면 테두리 -->
            <Border x:Name="DropFrame" IsHitTestVisible="False" IsVisible="False"
                    BorderBrush="{DynamicResource AppPrimary}" BorderThickness="2"/>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource AppTextMid}"/>
        </Grid>

        <!-- 상태 표시줄: 오류가 있으면 오류 문구(눌러서 닫기), 없으면 항목 수 -->
        <Border Grid.Row="3" x:Name="StatusBar" Classes.error="{Binding HasError}"
                BorderBrush="{DynamicResource AppStroke}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="{DynamicResource FsSmall}"
                           Foreground="{DynamicResource AppTextMid}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding FilterText}" FontSize="{DynamicResource FsSmall}" Margin="12,0,0,0"
                           Foreground="{DynamicResource AppPrimary}"
                           IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
